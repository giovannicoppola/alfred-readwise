# Example Environment Configuration for readwise-go
# Copy this file to .env and set your actual values

# Required: Your Readwise API token
READWISE_TOKEN=your_readwise_token_here

# Content type filters (1 = enabled, 0 = disabled)
ARTICLES_CHECK=1
TWEETS_CHECK=1
BOOKS_CHECK=1
PODCASTS_CHECK=1
SUPPLEMENTALS_CHECK=1

# Title for new highlights created via Alfred
NEW_HIGH_TITLE=From Alfred

# Search scope: "Text", "Book", or "Both"
SEARCH_SCOPE=Both

# How often to refresh the database (in days)
RefreshRate=1

# Alfred workflow data directory (usually set automatically by Alfred)
# alfred_workflow_data=/path/to/alfred/workflow/data

# Example usage:
# export READWISE_TOKEN=your_token_here
# ./readwise-go query "search term"
