				<key>script</key>
				<string># Opens the Readwise/Reader page for the selected item.
# Highlights always open in the browser; a Reader document honours READER_OPEN_IN.
url="$myURL"
[ -n "$url" ] || exit 0

case "$url" in
  https://read.readwise.io/*)
    if [ "$READER_OPEN_IN" = "App" ]; then
      # fall back to the browser if the app is not installed
      open -a "Reader" "$url" 2&gt;/dev/null || open "$url"
      exit 0
    fi
    ;;
esac
open "$url"
</string>
